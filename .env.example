# 로컬 개발은 Vite 프록시를 사용하므로 비워 둡니다.
# 다른 도메인을 쓰면 백엔드에서 해당 Origin 및 credentials CORS 설정이 필요합니다.
VITE_API_BASE_URL=
VITE_LOCAL_MOCK_LOGIN=false

# Vite 개발 서버만 사용하는 API 프록시 대상입니다.
# 병합 후 로컬 검증처럼 8080 포트를 다른 작업이 사용 중이면 예: http://localhost:8081
VITE_API_PROXY_TARGET=http://localhost:8080
# 선택: 로컬 Core/Chat 앱을 분리해서 실행할 때만 지정합니다. 비우면 기존 API 프록시로 전달합니다.
# 브라우저의 API 주소는 계속 동일 origin이며 내부 서비스 주소/비밀값을 지정하지 않습니다.
VITE_CHAT_PROXY_TARGET=

# 지역 채팅은 VITE_API_BASE_URL의 origin + /ws (HTTPS이면 WSS)를 사용합니다.
# 로컬 Vite는 채팅 REST·/ws upgrade를 VITE_CHAT_PROXY_TARGET(없으면 API 대상)으로 전달합니다.
